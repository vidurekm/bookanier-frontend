# Vite automaticky proxyuje /api na Spring Boot na portu 8080.
VITE_API_PROXY_TARGET=http://localhost:8080
# Volitelné: výchozí veřejné UUID organizace na úvodní stránce.
VITE_PUBLIC_ORG_ID=

# Produkční doména veřejného webu: https://bookanear.online
# Produkční proxy /api směřuje na bookanear-api:8080 (viz nginx/).
